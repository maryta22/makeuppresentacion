{
  "hooks": {
    "SubagentStop": [
      {
        "matcher": "^implementador$",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$(git rev-parse --show-toplevel)/.codex/hooks/spec-gate.js\"",
            "timeout": 120,
            "statusMessage": "Spec gate: revisando el cambio del implementador"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$(git rev-parse --show-toplevel)/.codex/hooks/spec-gate.js\"",
            "timeout": 120,
            "statusMessage": "Spec gate: escenarios, pruebas y validación"
          }
        ]
      }
    ]
  }
}
